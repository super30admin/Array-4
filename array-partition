class Solution {
    public int arrayPairSum(int[] nums) {
        int n = nums.length;
        int result = 0;
        // sorting the array
        Arrays.sort(nums);// nlogn
        for (int i = 0; i < n; i += 2) {// O(n)
            result += nums[i];// adding alternate elements to results as we need to consider min of pair
        }
        return result;
    }
}


