class Solution {
    public void nextPermutation(int[] nums) {
        if(nums==null)
            return;
        int n=nums.length;
        int i=n-2;
        while(i>=0 && nums[i]>=nums[i+1])
        {
            i--;
        }
        if(i>=0){
            int j=n-1;
            while(nums[i]>=nums[j]){
                j--;
            }
            inte(nums,i,j);
        }
        inter(nums,i+1,n-1);
    }
    private void inter(int[] nums, int l, int r){
        while(l<r){
            inte(nums,l,r);
            l++;
            r--;
        }
    }
    private void inte(int[] nums,int i,int j){
        int temp=nums[i];
        nums[i]=nums[j];
        nums[j]=temp;
    }
}