class Solution {
    public int maxSubArray(int[] nums) {
        int n = nums.length;
        int currSum = 0;//initilizing curr Sum
        int max =Integer.MIN_VALUE;//initilizing max Sum
        for (int i = 0; i < n; i++) {
            currSum = Math.max(nums[i], currSum + nums[i]);//taking max from curr and curr with previous
            max = Math.max(currSum, max);// taking max from curr and global max
        }
        return max;
    }
}


